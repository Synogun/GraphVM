{
    "name": "graphvm",
    "private": true,
    "version": "2.5.0",
    "type": "module",
    "author": "Synogun",
    "license": "MIT",
    "description": "GraphVM is an online tool designed for fast, efficient, and intuitive graph modeling, visualization, and manipulation.",
    "scripts": {
        "update": "npx ncu --format group",
        "update-u": "npx ncu --format group -u",
        "dev": "vite",
        "dev:host": "vite --host",
        "build": "tsc -b && vite build",
        "review": "lint && typecheck && test",
        "lint": "eslint ./src",
        "lint:fix": "eslint ./src --fix",
        "typecheck": "tsc -b --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:unit": "vitest run tests/unit",
        "test:integration": "vitest run tests/integration",
        "test:e2e": "playwright test",
        "format": "prettier --write \"src/**/*\"",
        "preview": "vite preview",
        "countcode": "..\\cloc-2.08.exe --exclude-dir=dist,logs,node_modules,python --exclude-ext=json,md ."
    },
    "dependencies": {
        "@tailwindcss/vite": "4.2.2",
        "cytoscape": "3.33.2",
        "cytoscape-context-menus": "4.2.1",
        "cytoscape-fcose": "2.2.0",
        "daisyui": "5.5.19",
        "react": "19.2.5",
        "react-dom": "19.2.5",
        "react-icons": "5.6.0",
        "tailwindcss": "4.2.2"
    },
    "devDependencies": {
        "@playwright/test": "1.59.1",
        "@types/cytoscape-context-menus": "4.1.5",
        "@types/cytoscape-fcose": "2.2.5",
        "@types/node": "25.6.0",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "5.2.0",
        "@vitest/coverage-v8": "4.1.4",
        "babel-plugin-react-compiler": "1.0.0",
        "eslint": "9.39.4",
        "eslint-plugin-react-hooks": "7.0.1",
        "eslint-plugin-react-refresh": "0.5.2",
        "globals": "17.4.0",
        "jiti": "2.6.1",
        "jsdom": "28.1.0",
        "npm-check-updates": "19.6.6",
        "prettier": "3.8.2",
        "typescript": "5.9.3",
        "typescript-eslint": "8.58.1",
        "vite": "7.3.2",
        "vitest": "4.1.4"
    }
}
